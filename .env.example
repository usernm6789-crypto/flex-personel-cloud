# Production: set DATABASE_URL to your managed PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Usually leave DATABASE_SSL=true for cloud PostgreSQL.
DATABASE_SSL=true
DB_POOL_MAX=10
PORT=3000
NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-secret
FLEX_RECOVERY_CODE=replace-with-a-private-recovery-code
